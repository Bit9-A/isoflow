{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "Isoflow",
  "version": "1.1.1",
  "identifier": "com.isoflow.app",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist-app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Isoflow",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
